---
interface Props {
  linkRef: string;
  size: string;
  iconPath: string;
  alt: string
  targetLink?: string
}

const {linkRef, size, iconPath, alt, targetLink = '_self'} = Astro.props;
---
<a target= {targetLink} href= {linkRef}>
  <img decoding="async" loading="lazy" class={size} src={iconPath} alt={alt}></img>
</a>

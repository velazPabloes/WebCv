---
import IconImg from './IconImg.astro';
import Subtitle from './Subtitle.astro';
import NormalText from './NormalText.astro';
import CardBar from './CardBar.astro';

interface Props {
	imgPath: string;
  cardTitle: string;
  cardParagraph: string[];
  iconButton1?: string;
  iconButton2?: string;
  linkButton1: string;
  linkButton2: string;
  textButton1?: string;
  textButton2?: string;
  iconLogo1: string;
  iconLogo2: string;
  iconLogo3: string;
  linkLogo1: string;
  linkLogo2: string;
  linkLogo3: string;
}

const { imgPath, cardTitle, cardParagraph, iconButton1 = '../../public/icons/git-hub.svg', iconButton2 = '../../public/icons/eye.svg', linkButton1, linkButton2, textButton1 = 'Codigo', textButton2 = 'Preview', iconLogo1, iconLogo2, iconLogo3, linkLogo1, linkLogo2, linkLogo3  } = Astro.props;
---
<div class="w-3/4 h-5/6 grid grid-rows-10 grid-cols-2 justify-center bg-white rounded-lg border-2 border-black">
  <div class="row-start-1 row-span-1 col-start-1 col-span-2">
    <CardBar/>
  </div>
  <div class="flex text-start justify-start row-start-3 row-span-1 col-start-1 col-span-1 px-6 py-2">
    <Subtitle title={cardTitle}/>
  </div>
  <div class="flex flex-col justify-start items-start row-start-4 row-span-4 col-start-1 col-span-1 px-8 py-4">
    <NormalText>
      {cardParagraph.map(paragraph => (
        <p class="text-start">{paragraph}</p>
      ))}
    </NormalText>
  </div>
  <div class="flex justify-start items-center row-start-9 row-span-1  col-start-1 col-span-1 px-8 gap-4">
    <button onclick={`window.open('${linkButton1}', '_blank');`} class="flex items-stretch gap-4 bg-black hover:bg-gray-900 text-white font-semibold py-1 px-4 rounded-md border-gray-400  shadow">
      <div class="flex justify-center items-center">
        <IconImg linkRef= {linkButton1} iconPath= {iconButton1} size='size-5' alt='gitHub'/>
        
      </div>
      <span class="flex items-center text-end text-sm">{textButton1}</span>
    </button>
    <button onclick={`window.open('${linkButton2}', '_blank');`} class="flex items-stretch gap-4 bg-black hover:bg-gray-900 text-white font-semibold py-1 px-4 rounded-md border-gray-400  shadow">
      <div class="flex justify-center items-center">
        <IconImg linkRef= {linkButton2} iconPath= {iconButton2} size='size-5' alt='gitHub'/>
        
      </div>
      <span class="flex items-center text-end text-sm">{textButton2}</span>
    </button>
  </div>

  <div class="flex justify-center items-center row-start-9 row-span-1 col-start-2 col-span-2 pr-4 py-6 gap-4 ">
    <div class="flex items-stretch gap-4">
      <IconImg linkRef= {linkLogo1} iconPath= {iconLogo1} size='size-8' alt='Icon'/>
    </div>

    <div class="flex items-stretch gap-4">
      <IconImg linkRef= {linkLogo2} iconPath= {iconLogo2} size='size-8' alt='Icon'/>
    </div>

    <div class="flex items-stretch gap-4">
      <IconImg linkRef= {linkLogo3} iconPath= {iconLogo3} size='size-8' alt='Icon'/>
    </div>
  </div>


  <div class="w-11/12 grid grid-rows-10 grid-cols-1 row-start-3 row-span-6 col-start-2 col-span-1 bg-white rounded-lg border-2 border-black relative">
    <div class="h-full row-start-1 row-span-1 col-start-1 col-span-1 absolute left-0 right-0">
      <CardBar/>
    </div>
    <div class="flex justify-center w-full h-auto items-start row-start-1 row-span-10 col-start-1 col-span-1 bottom-0 top-0">
      <div class="w-full h-full">
        <img class='w-full h-full rounded-lg' src={imgPath}>
      </div>
    </div>
  </div>
</div>
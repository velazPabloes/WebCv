---
/*COMPONENT IMPORTS*/
import HorizontalWindow from "../../components/HorizontalWindow.astro";
import Layout from "../../layouts/Layout2.astro";
import Carrousel from "../../components/HorizontalCarrousel.astro";

/*IMG IMPORTS*/
const etsiiBuildingImg = '/img/etsiiBuilding.webp';
const salesianosBuildingImg = '/img/etsiiBuilding.webp';
const htwgKonstanzBuildingImg = '/img/htwgKonstanzBuilding.webp';

/*ICON IMPORTS*/
---

<Layout title="Educacion" mainTittle="EDUCACION" >
  <Carrousel>
    <!-- Card 1 -->
    <div class="swiper-slide">
      <HorizontalWindow cardTitle="Ingenieria Informatica"   
      cardParagraph={[
        "-Grado Universitario",
        "-ETSII (Universidad de Sevilla)",
        "-2021 - Actualidad"
      ]} imgPath= {etsiiBuildingImg}/>  
    </div> 

    <!-- Card 2 -->
    <div class="swiper-slide">
      <HorizontalWindow cardTitle="Erasmus"   
      cardParagraph={[
        "-Grado Universitario",
        "-HTWG Konstanz (Alemania)",
        "-2023 - 2024"
      ]} imgPath= {htwgKonstanzBuildingImg}/>  
    </div> 
    
    <!-- Card 3 -->
    <div class="swiper-slide">
      <HorizontalWindow cardTitle="Ciencias de la Salud"   
      cardParagraph={[
        "-Bachillerato",
        "-Salesianos de Triana",
        "-2019 - 2021"
      ]} imgPath= {salesianosBuildingImg}/>
    </div> 

    <!-- Card 4 -->
    <div class="swiper-slide">
      <HorizontalWindow cardTitle="Primaria y ESO"   
      cardParagraph={[
        "-Educación Obligatoria",
        "-Salesianos de Triana",
        "-2011 - 2019"
      ]} imgPath= {salesianosBuildingImg}/>   
    </div>  
  </Carrousel>
</Layout>

<style>
  .swiper-slide{
    display: flex;
    justify-content: center;
    align-items: start;
  }
</style>


<script src="../../../libs/horizontal_swiper.js"></script>
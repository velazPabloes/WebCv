---
/*COMPONENT IMPORTS*/
import VerticalWindow from "../../components/VerticalWindow.astro";
import Layout from "../../layouts/Layout2.astro";
import Carrousel from "../../components/VerticalCarousel.astro";

/*IMAGE IMPORTS*/
const oopImg = '/img/oop.webp';
const webDevelopmentImg = '/img/webDevelopment.webp';
const aiImg = '/img/ai.webp';
const dataAnalysisImg = '/img/dataAnalysis.webp';
const versionControlImg = '/img/versionControl.webp';
const securityImg = '/img/security.webp';

/*ICON IMPORTS*/
---

<Layout title="Programacion" mainTittle="PROGRAMACION">
  <Carrousel>
    <!-- Card 1 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="POO" imgPath= {oopImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/> 
    </div> 
    
    <!-- Card 2 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="DESARROLLO WEB" imgPath= {webDevelopmentImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/>
    </div> 

    <!-- Card 3 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="IA" imgPath= {aiImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/>
    </div>  

    <!-- Card 4 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="ANALISIS DE DATOS" imgPath= {dataAnalysisImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/> 
    </div> 
    
    <!-- Card 5 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="CONTROL DE VERSIONES" imgPath= {versionControlImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/>
    </div> 

    <!-- Card 6 -->
    <div class="swiper-slide">
      <VerticalWindow cardTitle="SEGURIDAD" imgPath= {securityImg} cardRef="#" widthCard="w-5/6 ", heightCard="h-5/6 "/>
    </div>     
  </Carrousel>
</Layout>

<style>
  .swiper-slide{
    display: flex;
    justify-content: center;
    align-items: start;
  }
</style>


<script src="../../../libs/vertical_swiper.js"></script>

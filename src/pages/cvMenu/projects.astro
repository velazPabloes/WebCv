---
import IconsHorizontalWindow from "../../components/IconsHorizontalWindow.astro";
import Layout from "../../layouts/Layout2.astro";
import Carrousel from "../../components/HorizontalCarrousel.astro";
---

<Layout title="Projectos" mainTittle="PROJECTOS" client:load>
  <Carrousel>
    <!-- Card 1 -->
    <div class="swiper-slide">
      <IconsHorizontalWindow cardTitle="Peluqueria Web"   
      cardParagraph={[
        "Desarrollo Web",
        "Tienda online de una peluqueria",
        "Permite pedir citas al cliente"
      ]} imgPath="../../../public/img/peluWebProject.png" linkButton1="https://github.com/velazPabloes" linkButton2="https://github.com/velazPabloes" iconLogo1="../../../public/icons/astro.svg" iconLogo2="../../../public/icons/react.svg" iconLogo3="../../../public/icons/tailwind.svg" linkLogo1="#" linkLogo2="#" linkLogo3="#"/>  
    </div> 
    
    <!-- Card 2 -->
    <div class="swiper-slide">
      <IconsHorizontalWindow cardTitle="3d Sounds"   
      cardParagraph={[
        "Desarrollo Web, IA, Analisis de Datos",
        "Visualizacion en 3d de los sonidos de una cancion",
        ""
      ]} imgPath="../../../public/img/3dSoundProject.png" linkButton1="https://github.com/velazPabloes" linkButton2="https://github.com/velazPabloes" iconLogo1="../../../public/icons/astro.svg" iconLogo2="../../../public/icons/react.svg" iconLogo3="../../../public/icons/tailwind.svg" linkLogo1="#" linkLogo2="#" linkLogo3="#"/>
    </div> 
  </Carrousel>
</Layout>

<style>
  .swiper-slide{
    display: flex;
    justify-content: center;
    align-items: start;
  }
</style>


<script src="../../../libs/horizontal_swiper.js"></script>
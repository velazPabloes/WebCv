---
/*COMPONENT IMPORTS*/
import IconsHorizontalWindow from "../../components/IconsHorizontalWindow.astro";
import Layout from "../../layouts/Layout2.astro";
import Carrousel from "../../components/HorizontalCarrousel.astro";

/*IMAGE IMPORTS*/
const peluWebProjectImg = '/img/peluWebProject.webp';
const dSoundProjectImg = '/img/3dSoundProject.webp';

/*ICON IMPORTS*/
const astroIcon = '/icons/astro.svg';
const tailwindIcon = '/icons/tailwind.svg';
const reactIcon = '/icons/react.svg';

---

<Layout title="Projectos" mainTittle="PROJECTOS">
  <Carrousel>
    <!-- Card 1 -->
    <div class="swiper-slide">
      <IconsHorizontalWindow cardTitle="Peluqueria Web"   
      cardParagraph={[
        "Desarrollo Web",
        "Tienda online de una peluqueria",
        "Permite pedir citas al cliente"
      ]} imgPath= {peluWebProjectImg} linkButton1="https://github.com/velazPabloes" linkButton2="https://github.com/velazPabloes" iconLogo1= {astroIcon} iconLogo2= {reactIcon} iconLogo3= {tailwindIcon} linkLogo1="#" linkLogo2="#" linkLogo3="#"/>  
    </div> 
    
    <!-- Card 2 -->
    <div class="swiper-slide">
      <IconsHorizontalWindow cardTitle="3d Sounds"   
      cardParagraph={[
        "Desarrollo Web, IA, Analisis de Datos",
        "Visualizacion en 3d de los sonidos de una cancion",
        ""
      ]} imgPath= {dSoundProjectImg} linkButton1="https://github.com/velazPabloes" linkButton2="https://github.com/velazPabloes" iconLogo1= {astroIcon} iconLogo2= {reactIcon} iconLogo3= {tailwindIcon} linkLogo1="#" linkLogo2="#" linkLogo3="#"/>
    </div> 
  </Carrousel>
</Layout>

<style>
  .swiper-slide{
    display: flex;
    justify-content: center;
    align-items: start;
  }
</style>


<script src="../../../libs/horizontal_swiper.js"></script>